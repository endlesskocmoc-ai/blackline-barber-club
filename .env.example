# ========================================================
# BLACKLINE BARBER CLUB — Безопасная конфигурация
# ========================================================

# GEMINI_API_KEY: Injected by AI Studio for optional Gemini features
GEMINI_API_KEY=""

# APP_URL: URL application host
APP_URL="http://localhost:3000"

# --- Supabase PostgreSQL (Серверное подключение для Netlify / Server) ---
# Зарегистрируйтесь на https://supabase.com/ (бесплатный тариф)
# 1. Создайте проект (Project Settings -> API)
# 2. Скопируйте Project URL и service_role secret (секретный ключ сервера, НЕ раскрывать клиенту!)
# 3. Выполните скрипт supabase/schema.sql в SQL Editor проекта
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- JWT Секрет для авторизации администратора ---
# Случайная криптостойкая строка для подписи токенов сессий
JWT_SECRET="generate_a_random_32_char_secret_key_here"

# --- EmailJS Интеграция (клиентские уведомления) ---
VITE_EMAILJS_SERVICE_ID=""
VITE_EMAILJS_TEMPLATE_ID=""
VITE_EMAILJS_PUBLIC_KEY=""
